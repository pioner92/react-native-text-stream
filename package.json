{
  "name": "react-native-text-stream",
  "private": true,
  "scripts": {
    "build": "bun run --cwd packages/react-native-text-stream build",
    "codegen": "bun run --cwd example/modules/text-stream-testing nitrogen",
    "release": "bun run --cwd packages/react-native-text-stream release",
    "postinstall": "sh scripts/apply-patches.sh",
    "test": "bun run --cwd packages/react-native-text-stream test",
    "test:harness": "bun run --cwd example test:harness"
  },
  "workspaces": [
    "packages/*",
    "example"
  ],
  "packageManager": "bun@1.4.2"
}
