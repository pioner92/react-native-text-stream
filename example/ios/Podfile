# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TextStreamExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # The tests and benchmarks read StreamText's instrumentation, which apps don't get.
    # STREAMTEXT_TESTING=0 pod install builds without it and without the testing module, as an app
    # would: a build check only (the example's JS imports text-stream-testing).
    installer.pods_project.targets.each do |target|
      next unless target.name == 'TextStream' && ENV['STREAMTEXT_TESTING'] != '0'
      target.build_configurations.each do |build|
        {
          'SWIFT_ACTIVE_COMPILATION_CONDITIONS' => 'STREAMTEXT_TESTING',
          'GCC_PREPROCESSOR_DEFINITIONS' => 'STREAMTEXT_TESTING=1',
        }.each do |key, flag|
          build.build_settings[key] = "#{build.build_settings[key] || '$(inherited)'} #{flag}"
        end
      end
    end
  end
end
