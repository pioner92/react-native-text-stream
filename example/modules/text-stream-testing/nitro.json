{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "textstreamtesting"
  ],
  "ios": {
    "iosModuleName": "TextStreamTesting"
  },
  "android": {
    "androidNamespace": [
      "textstreamtesting"
    ],
    "androidCxxLibName": "TextStreamTesting"
  },
  "autolinking": {
    "FrameMonitor": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridFrameMonitor"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFrameMonitor"
      }
    },
    "StreamTextTesting": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridStreamTextTesting"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridStreamTextTesting"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
