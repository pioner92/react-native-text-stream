{
  "name": "react-native-text-stream-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --reset-cache",
    "stream-server": "node ../server/stream-server.mjs",
    "test": "jest",
    "pod": "bundle install && bundle exec pod install --project-directory=ios",
    "test:harness": "react-native-harness --config jest.harness.config.mjs --harnessRunner ios",
    "test:harness:android": "react-native-harness --config jest.harness.config.mjs --harnessRunner android"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.0",
    "katex": "0.16.22",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-nitro-fetch": "*",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-text-decoder": "0.1.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-streamdown": "0.3.0",
    "react-native-text-stream": "*",
    "react-native-worklets": "0.13.0",
    "remend": "1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native-harness/platform-android": "1.5.0",
    "@react-native-harness/platform-apple": "1.5.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "babel-plugin-module-resolver": "^5.0.2",
    "nitrogen": "0.37.1",
    "react-native-harness": "1.5.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
