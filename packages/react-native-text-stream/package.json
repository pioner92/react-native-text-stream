{
  "name": "react-native-text-stream",
  "version": "0.1.0",
  "description": "A native React Native text view that renders a streamed response as it arrives, without JS per chunk",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "prepack": "bun run build",
    "build": "bun run typecheck && bob build",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "react-native-text-stream"
  ],
  "files": [
    "src",
    "!src/**/__tests__/**",
    "react-native.config.js",
    "lib",
    "cpp",
    "android/build.gradle",
    "android/src",
    "!android/src/test",
    "!android/src/androidTest",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "repository": "https://github.com/pioner92/react-native-text-stream.git",
  "author": "Alex Shumihin",
  "license": "MIT",
  "bugs": "https://github.com/pioner92/react-native-text-stream/issues",
  "homepage": "https://github.com/pioner92/react-native-text-stream#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.2.0",
    "babel-jest": "30.5.2",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "jest": "30.5.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "semantic-release": "^25.0.7",
    "test-renderer": "1.3.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "TextStreamSpec",
    "type": "modules",
    "jsSrcsDir": "src/codegen",
    "ios": {
      "modulesProvider": {
        "StreamTextBuffers": "StreamTextBuffersProvider"
      }
    }
  }
}
